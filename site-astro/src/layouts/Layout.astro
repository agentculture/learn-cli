---
// The shared shell — copied verbatim in spirit from org/site-astro's Layout
// (same head metas, same font preloads, same inline reveal script; zero new
// design tokens). The one addition is `homeHref`: this site is nested under
// /<subject>/ and /<subject>/stories/<id>/ routes, so each page computes its
// own relative path back to the learn landing page and hands it down to
// Header/Footer rather than hard-coding an absolute "/" (see README.md's
// "Base path and relative links" note).
//
// t14 adds one more thing: `<script>` importing src/scripts/learner.js on
// every page. Astro bundles a non-`is:inline` `<script>` through Vite like
// it does the fonts above, so it comes out of `astro build` as a normal
// hashed, base-prefixed asset — no relative-path bookkeeping needed here,
// unlike the page-to-page links in Header/Footer. See that file and
// README.md's "Auth" section for what it does and the zero-API-when-
// signed-out guarantee it's required to keep.
import "@fontsource-variable/albert-sans";
import "@fontsource-variable/fraunces/full.css";
import "../styles/global.css";
import albertUrl from "@fontsource-variable/albert-sans/files/albert-sans-latin-wght-normal.woff2?url";
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url";
import site from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  /** Document title, already fully composed by the page. */
  title: string;
  /** Meta description — pages pull this from the content-export data. */
  description: string;
  /** Relative path from the current page back to the learn site root
   * ("./" on the landing page itself, "../" one level down, "../../../"
   * two levels down, …). Header/Footer use it for the local "Subjects" link. */
  homeHref: string;
}

const { title, description, homeHref } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${site.orgTitle} ${site.title}`} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f5fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0f20" />
    <link rel="icon" type="image/svg+xml" href={`${homeHref}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${homeHref}apple-touch-icon.png`} />
    <link rel="preload" as="font" type="font/woff2" href={frauncesUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={albertUrl} crossorigin />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Flag JS availability before first paint: entrance-hidden states in
      // the CSS apply only under `html.js`, so a no-JS visit renders
      // everything composed and visible.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header homeHref={homeHref} />
    <main id="main">
      <slot />
    </main>
    <Footer homeHref={homeHref} />
    <script>
      import "../scripts/learner.js";
    </script>
    <script is:inline>
      // Scroll reveals: observe [data-reveal] and settle each element in
      // once. Runs only when the visitor allows motion — otherwise the CSS
      // never hides anything and there is nothing to reveal.
      (function () {
        if (!matchMedia("(prefers-reduced-motion: no-preference)").matches) return;
        if (!("IntersectionObserver" in window)) {
          document.documentElement.classList.remove("js");
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -36px 0px" }
        );
        document.querySelectorAll("[data-reveal]").forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
